<mujoco model="diff_drive_car">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <!-- Ground -->
    <geom type="plane" size="5 5 0.1"
          friction="1 0.1 0.1"
          rgba="0.8 0.8 0.8 1"/>

    <!-- Robot -->
    <body name="car" pos="0 0 0.05">
      <joint type="free"/>

      <!-- Body -->
      <geom type="box" size="0.2 0.15 0.05"
            mass="2"
            rgba="0 0 1 1"/>

      <!-- LEFT WHEEL -->
      <body name="left_wheel" pos="0 0.15 0">
        <joint name="left_joint"
               type="hinge"
               axis="0 1 0"
               damping="0.5"/>
        <geom type="cylinder"
              size="0.05 0.02"
              euler="90 0 0"
              friction="1 0.1 0.1"
              mass="0.2"
              rgba="1 0 0 1"/>
      </body>

      <!-- RIGHT WHEEL -->
      <body name="right_wheel" pos="0 -0.15 0">
        <joint name="right_joint"
               type="hinge"
               axis="0 1 0"
               damping="0.5"/>
        <geom type="cylinder"
              size="0.05 0.02"
              euler="90 0 0"
              friction="1 0.1 0.1"
              mass="0.2"
              rgba="1 0 0 1"/>
      </body>

      <!-- CASTOR (chống lật + tạo tiếp xúc đúng) -->
      <body name="caster" pos="-0.15 0 -0.02">
        <geom type="sphere"
              size="0.03"
              friction="0.2 0.01 0.01"
              rgba="0 1 0 1"/>
      </body>

    </body>
  </worldbody>

  <actuator>
    <motor joint="left_joint" ctrlrange="-3 3"/>
    <motor joint="right_joint" ctrlrange="-3 3"/>
  </actuator>
</mujoco>